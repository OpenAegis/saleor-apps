{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "build": {
    "env": {
      "DEPLOY_ALL_APPS": "true"
    }
  },
  "env": {
    "DEPLOY_ALL_APPS": "true"
  },
  "builds": [
    {
      "src": "avatax/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "cms/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "klaviyo/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "np-atobarai/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "products-feed/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "search/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "segment/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "smtp/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "stripe/package.json",
      "use": "@vercel/next"
    }
  ],
  "functions": {
    "cms/src/pages/api/webhooks/*.*": {
      "memory": 512
    },
    "products-feed/src/pages/api/feed/**/*": {
      "memory": 3008,
      "maxDuration": 300
    },
    "search/src/pages/api/webhooks/saleor/**/*": {
      "memory": 512
    },
    "segment/src/pages/api/webhooks/*": {
      "memory": 256,
      "maxDuration": 15
    },
    "smtp/src/pages/api/webhooks/*": {
      "memory": 512,
      "maxDuration": 25
    }
  },
  "regions": ["dub1", "iad1"],
  "routes": [
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/avatax"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
