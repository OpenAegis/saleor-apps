{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "build": {
    "env": {
      "DEPLOY_ALL_APPS": "true"
    }
  },
  "env": {
    "DEPLOY_ALL_APPS": "true"
  },
  "builds": [
    {
      "src": "avatax/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "cms/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "klaviyo/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "np-atobarai/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "products-feed/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "search/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "segment/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "smtp/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "stripe/package.json",
      "use": "@vercel/next"
    }
  ],
  "regions": ["fra1"],
  "routes": [
    {
      "src": "/",
      "status": 302,
      "headers": {
        "Location": "/avatax"
      }
    },
    {
      "src": "/avatax(.*)",
      "dest": "avatax"
    },
    {
      "src": "/cms(.*)",
      "dest": "cms"
    },
    {
      "src": "/klaviyo(.*)",
      "dest": "klaviyo"
    },
    {
      "src": "/np-atobarai(.*)",
      "dest": "np-atobarai"
    },
    {
      "src": "/products-feed(.*)",
      "dest": "products-feed"
    },
    {
      "src": "/search(.*)",
      "dest": "search"
    },
    {
      "src": "/segment(.*)",
      "dest": "segment"
    },
    {
      "src": "/smtp(.*)",
      "dest": "smtp"
    },
    {
      "src": "/stripe(.*)",
      "dest": "stripe"
    },
    {
      "handle": "filesystem"
    }
  ]
}
